{
  "name": "jrs-esign-desktop",
  "productName": "JRS eSign",
  "version": "1.0.0",
  "description": "Desktop app for the JRS e-signature system. It opens the shared eSign server in its own window; all data stays on the server.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icons": "electron scripts/make-icons.js",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.jrsllc.esign",
    "productName": "JRS eSign",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "offline.html", "settings.html", "config.json", "build/icon.png", "build/tray.png"],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JRS eSign"
    }
  }
}
