# Copy this file to ".env" (same folder) and fill in your values, then restart the server.
# Never commit .env to Git: it holds your passwords.

COMPANY_NAME=JRS LLC
ADMIN_PASSWORD=change-me-to-a-strong-password

# Public address people use to open signing links.
# Keep localhost only for testing on this PC; signers on other computers need a real address.
BASE_URL=http://localhost:3000

# ---- Outgoing email (Microsoft 365 / Outlook) ----
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=esign@jrsllc.com
SMTP_PASS=the-mailbox-password-or-app-password
# Must be the same mailbox as SMTP_USER (or one it has "Send As" rights for).
MAIL_FROM=esign@jrsllc.com

# Where "X signed", "declined" and "completed" notices go (usually you).
NOTIFY_EMAIL=you@jrsllc.com
