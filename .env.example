# Method 365 settings.
# Copy this file to ".env" (same folder), fill in your values, then restart the server.
# Never commit .env to Git: it holds passwords. See PRODUCTION.md for going live.

# ---- Names ----
# The app's name, shown in the header, emails and PDFs.
APP_NAME=Method 365
# The company using it: full name, and the short form shown next to it.
COMPANY_NAME=Jupiter Research Services
COMPANY_SHORT=JRS
# Agreement numbers look like JRS-2026-00001.
AGREEMENT_PREFIX=JRS

# ---- Server ----
# "production" turns on start-up safety checks (strong ADMIN_PASSWORD, https BASE_URL, email set).
NODE_ENV=production
PORT=3000
# Public https address people use to open signing links (no trailing slash).
BASE_URL=https://esign.method365sign.com
# Only for docker-compose: the domain Caddy gets an HTTPS certificate for (same host as BASE_URL).
ESIGN_DOMAIN=esign.method365sign.com

# Setup password: needed once, to create the first administrator. 12+ characters.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# Sign out after this many minutes without activity.
SESSION_IDLE_MINUTES=30
# Two-step sign-in (password + emailed code). TESTING ONLY: LOGIN_CODE=off signs in with the password
# alone; production refuses to start with it off.
# LOGIN_CODE=off

# ---- Storage ----
# Agreements, PDFs, users, certificate keys and logs. Back this up.
# DATA_DIR=/opt/esign/data
# Where backups and restore points go (default: "backups" next to the data folder).
# BACKUP_DIR=/opt/esign/backups
# Automatic backups are set under Admin > Backup and restore (production default: daily at 02:00).
# Until an administrator sets a schedule there, AUTO_BACKUP_HOURS (if set) is used instead.
# AUTO_BACKUP_HOURS=24
BACKUP_KEEP=14

# ---- System administrator ----
# The only account that may restart the server or erase all data (Admin > Server restart). Other
# administrators can't, even with full access. Default: the first administrator, made at first-time setup.
# SYSTEM_ADMIN_EMAIL=you@example.com

# ---- Outgoing email ----
# The company mailbox on the webhostbox cPanel server (see cPanel -> Email Accounts -> Connect Devices).
SMTP_HOST=sh00007.webhostbox.net
SMTP_PORT=465
# true for port 465 (SSL); false for 587.
SMTP_SECURE=true
SMTP_USER=esign-jrsllc@method365sign.com
SMTP_PASS=the-mailbox-password
# Name the app gives the mail server when connecting. Default: mail.<MAIL_FROM's domain>.
# Never leave it as the computer's name: mail servers may silently drop such mail.
# SMTP_HELO_NAME=mail.method365sign.com
# Must be the SMTP_USER mailbox, or one it has "Send As" rights for.
MAIL_FROM=esign-jrsllc@method365sign.com

# Gets "signed", "declined", "completed" and "signing locked" notices.
NOTIFY_EMAIL=esign-jrsllc@method365sign.com
# Contact address shown on the policy page (/policy.html). Default: MAIL_FROM.
SUPPORT_EMAIL=esign-jrsllc@method365sign.com

# ---- Advanced ----
# Which proxies may set the visitor's IP address (recorded in audit trails).
# Default trusts proxies on this machine and private networks (Caddy, Nginx, Docker, ngrok).
# TRUST_PROXY=loopback, linklocal, uniquelocal
# Country code in signer certificates.
# PKI_COUNTRY=US
